  | add p q hp hq =>
    rw [map_add (f := _), ← hp, ← hq]
    ext μ
    rw [MvPolynomial.coeff_add, coeff_divDer, coeff_divDer, coeff_divDer, MvPolynomial.coeff_add, add_mul]

