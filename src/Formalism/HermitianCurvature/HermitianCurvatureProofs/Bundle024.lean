def Xuv (k r : ℕ) (u v : Fin (2 * r + k + 1) → ℂ) : B.Mat k r :=
  vecMulVec u (star (Hpk k r *ᵥ v)) - vecMulVec v (star (Hpk k r *ᵥ u))

