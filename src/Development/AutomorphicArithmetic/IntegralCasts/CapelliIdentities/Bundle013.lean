theorem UpperTheory.Reformulated.B.Qe29.isotypic_stable_gl_operator.{u_1, u_2} :
    ∀ {n : ℕ} {K : Type u_1} {V : Type u_2} [inst : Field K] [inst_1 : AddCommGroup V] [inst_2 : _root_.Module K V]
