    a5 := h.a5, temp := _root_.UpperTheory.GalC.Tr.admissible_seven_restrict_alt h.temp, g4p := _root_.UpperTheory.GalC.Tr.no_g4_restrict_alt h41 h.g4p, gsp := h.gsp }
