  have key : ∀ (u u' : HeightOneSpectrum (𝓞 D.host.E)) (_ : u = u') (a : GlobalTheory.LocGL.IrrGL (k := u.adicCompletion D.host.E))
      (b : GlobalTheory.LocGL.IrrGL (k := u'.adicCompletion D.host.E)), HEq a b →
