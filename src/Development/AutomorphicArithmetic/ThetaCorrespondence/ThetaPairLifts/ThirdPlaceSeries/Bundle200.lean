    (hq : HEq Pq Pq') (hs : HEq S S') (hh : HEq hL hL') (he : HEq eig eig') (hθ : HEq θ θ')
    (h : ∃ Bs : SideB D cf Rw low Pq S hL eig θ, TauTrue Bs.exp) :
    ∃ Bs : SideB D' cf' Rw' low' Pq' S' hL' eig' θ', TauTrue Bs.exp := by
  subst D' low'
  cases eq_of_heq hc
  cases eq_of_heq hr
  cases eq_of_heq hq
  cases eq_of_heq hs
  cases eq_of_heq hh
  cases eq_of_heq he
  cases eq_of_heq hθ
  exact h

