  have e : X.ω s (y * k, g) = X.ω s (y, g) * X.ω s (k, 1) := by
    rw [← map_mul, Prod.mk_mul_mk, mul_one]
  rw [e, Module.End.mul_apply, GlobalTheory.BotKerRealInv.weil_rep_fixes_compact_vector hL hX s hB ea ed Tp hk]
