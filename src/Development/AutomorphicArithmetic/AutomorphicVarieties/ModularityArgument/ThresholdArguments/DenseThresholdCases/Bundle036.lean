private theorem norm_fin {F Ω : Type} [Field F] [NumberField F] [Field Ω] [Algebra F Ω] [IsAlgClosure F Ω] {l : ℕ} [Fact l.Prime]
    (ξ : _root_.Formalism.ConjugateSelfDual.G F Ω →* (Qbar l)ˣ) (hξ : IsOpen (ξ.ker : Set (_root_.Formalism.ConjugateSelfDual.G F Ω))) (g : _root_.Formalism.ConjugateSelfDual.G F Ω) : ‖(ξ g : Qbar l)‖ = 1 := by
