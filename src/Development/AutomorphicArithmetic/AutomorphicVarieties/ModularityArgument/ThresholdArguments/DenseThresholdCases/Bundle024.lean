      κ i s = cycBar K Ω l s ^ m i * (1 : _root_.Formalism.ConjugateSelfDual.G K Ω →* (Qbar l)ˣ) s := by
    intro i s hs
    fin_cases i
    · simpa [m] using (hI s hs).1
    · simpa [m] using (hI s hs).2
  have hor : ∀ i j, κ i ≠ κ j * (cycBar K Ω l).comp (_root_.ReciprocityTheory.Gal.Dec (F := K) A).subtype := by
    intro i j hij
    obtain ⟨s, hs, hne⟩ := UpperTheory.V.Ws.Pt.cycIne K Ω l A hAl (m i - m j - 1) (by
      fin_cases i <;> fin_cases j <;> simp [m] <;> omega)
