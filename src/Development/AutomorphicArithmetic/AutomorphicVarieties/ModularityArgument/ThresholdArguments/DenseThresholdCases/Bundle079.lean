    simp only [hρ']
    exact (hcont _ (fun g => (r' g).mat a b) fun n => (hr'.cont n).comp fun X => X a b).comp (galEmbTop ℚ K Ω).1.continuous
  obtain ⟨_, _⟩ := Db.algKL K L Ω (hLη.trans hker.le)
