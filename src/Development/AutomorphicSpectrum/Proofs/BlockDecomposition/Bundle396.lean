      have e1 := (ε : Γ(X, V) →+* (sP (KS q s {V})).A.obj E.D).map_det
        (Matrix.of fun k l => Ring.inverse (rs hVV (g l)) * D k (rs hVV (g l)))
      refine Eq.trans ?_ e1.symm
      congr 1
      ext i k
      simp [cc, inv_map]
    rw [e] at h5
