theorem _root_.GlobalTheory.T.convolution_smooth_lie_derivative : ∀ (E : Type) [Field E] [NumberField E] [_root_.NumberField.IsTotallyComplex E] (a : ℕ) (μ : Measure (GA E a)) [μ.IsHaarMeasure] [μ.IsMulRightInvariant] (U : Subgroup (GL (Fin a) (Af E))), IsOpen (U : Set (GL (Fin a) (Af E))) → IsCompact (U : Set (GL (Fin a) (Af E))) → ∀ β : Lie E a → ℂ, IsTest β → ∀ Fl : GA E a → ℂ, LocallyIntegrable Fl μ → convR μ (tst U β) Fl ∈ Sm E a ∧ ∀ (X : Lie E a) (g : GA E a), lieD X (convR μ (tst U β) Fl) g = convR μ (tst U (dTest X β)) Fl g := by
  first | exact @GlobalTheory.CompanionTheory.SmoothRep.convR_tst_mem_Sm | exact GlobalTheory.CompanionTheory.SmoothRep.convR_tst_mem_Sm | (intros; apply GlobalTheory.CompanionTheory.SmoothRep.convR_tst_mem_Sm <;> assumption)
