  ContinuousOn (fun u : ℂ × T => ∫ y, F u.1 u.2 y ∂μ) (U ×ˢ Set.univ) ∧
    ∀ t, DifferentiableOn ℂ (fun z => ∫ y, F z t y ∂μ) U := by
