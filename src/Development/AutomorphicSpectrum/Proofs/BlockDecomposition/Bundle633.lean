  intro F E _ _ _ _ _ σ _ M J _ n _ d b S φ A hφ hA hS
  have hc : IsCompact (boxFN A) := GlobalTheory.CompanionTheory.WhitFree.PureTuple.isCompact_boxF b S A (fun v => (hA v).1) hS
