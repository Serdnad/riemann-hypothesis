  first | exact @GlobalTheory.CompanionTheory.MirPair.evVal_conj | exact GlobalTheory.CompanionTheory.MirPair.evVal_conj | (intros; apply GlobalTheory.CompanionTheory.MirPair.evVal_conj <;> assumption)
end

