    obtain ⟨K, hK, hM⟩ := hm₁ D large₂ C' Cl hCl ⟨hb, by nlinarith, (le_max_right _ _).trans hm⟩ hcd hZ τ w w' hTT θ hθw W hW
      μsec hsec
    rw [e, ENNReal.ofReal_one, one_mul, hM lam' hl A hA]
