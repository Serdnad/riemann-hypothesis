theorem gramQ_mul {D : D7} (W : HSp D) {ρ : ℕ} (x : Matrix (Fin W.rank) (Fin ρ) D.host.E) (u : Matrix (Fin ρ) (Fin ρ) D.host.E) :
    gramQ W (x * u) = uᴴ * gramQ W x * u := by
