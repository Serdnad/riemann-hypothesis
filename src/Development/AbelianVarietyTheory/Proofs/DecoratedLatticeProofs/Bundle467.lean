      (Q := QE I.sel (I.tup I.mu0 : Chr B.fields.F B.fields.E B.fields.K)) B.sp.cm hQ hg
    have hq' : TC.PtOf (I.yStd u 0 c * x * TC.kStd X u (B.R.N 0)) q := by
