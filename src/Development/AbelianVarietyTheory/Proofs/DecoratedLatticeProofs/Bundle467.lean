    ∃ hJ : x ∈ Formalism.L2.Col.J0 B.sp.cm (B.R.N 0) ((B.primes X).vT u),
      Formalism.L2.Col.redG B.sp.cm (B.R.N 0) ((B.primes X).vT u) (B.primes X).vGs ⟨x, hJ⟩ = κ.2.1.1⁻¹ := by
