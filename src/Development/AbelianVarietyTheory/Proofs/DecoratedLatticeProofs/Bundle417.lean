  obtain ⟨q', hq'⟩ : ∃ q' : Formalism.L2.Col.ChPt (Pr := B.primes X) (R := B.R) I.sel (I.tup I.mu0) u 0, TC.PtOf (yc * xg * k ()) q' :=
