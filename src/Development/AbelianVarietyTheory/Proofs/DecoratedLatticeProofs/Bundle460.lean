theorem even_rankX {D : D7} (j : ℕ) (hj : j ≤ D.R.m) : Even (D.sp.X j).rank := by
  rw [Formalism.L2.Forms.rankN D j hj]
  show Even (D.R.k + j * (D.R.t + 1))
  obtain ⟨c, hc⟩ := D.R.t_odd
  exact D.R.k_even.add (Even.mul_left ⟨c + 1, by omega⟩ j)

