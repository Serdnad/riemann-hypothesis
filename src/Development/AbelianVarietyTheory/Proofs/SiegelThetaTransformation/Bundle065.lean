  have hinv : fmt T g * fmt T g⁻¹ = 1 := by
    rw [← (((GlobalTheory.T.rational_unitary_group_structure D S T C).2.2.2 T).2.1 g g⁻¹).2.1, mul_inv_cancel, (fmt_one T).1]
  have hshmov : IsMov (fmt T g) (Lv.sh C.X.Λ) (Lv.sh L) :=
