    rw [mul_assoc, e1, one_mul, hpX, hnorm, ← hpL]
  have hab : a * conj b = 1 := mul_right_cancel₀ hpL0 e2
  have hbb : b * conj b = 1 := by
    rw [Complex.mul_conj, Complex.normSq_eq_norm_sq, hb1]
    norm_num
  have hab' : a = b := by
