      show IsPrimitiveRoot x B.toPre.restRowsFiniteGroupCard
      rw [← IsPrimitiveRoot.map_iff_of_injective (f := B.embLL) B.embLL.injective, hx]
      exact Complex.isPrimitiveRoot_exp _ B.toPre.restRowsFiniteGroupCard_pos.ne'
