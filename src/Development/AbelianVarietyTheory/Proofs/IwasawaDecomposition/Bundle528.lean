  have hL := hA.isLB
  obtain ⟨a, ha⟩ := (tendsto_natCast_atTop_atTop.eventually (hA.eventually_isGloballyGenerated_twistZ F)).exists
  obtain ⟨k, s, hs⟩ := GlobalTheory.QCoh.isGloballyGenerated_iff_spanStalks.1 ha
