  first | exact @GlobalTheory.FrameNorm.Comparison₂.ptNorm_eq_pnorm | exact GlobalTheory.FrameNorm.Comparison₂.ptNorm_eq_pnorm | (intros; apply GlobalTheory.FrameNorm.Comparison₂.ptNorm_eq_pnorm <;> assumption)
