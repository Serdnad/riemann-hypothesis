  have h := hν.trans (val_self Y p H Ls n hs (GlobalTheory.T.valEqSelfSt_of_hyps C V O dd Y d Orb I0 p H Ls n) N pl P hP Po hQ kind hk S t ht gr hg)
  exact WithBot.coe_le_coe.1 h

