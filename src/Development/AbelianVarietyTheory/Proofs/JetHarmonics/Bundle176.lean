  intro h₁ h₂ h₃ h₄ h₅ hT E _ _ _ H Dw l Xo c n T io y _ C P _ g g' _ _ _ _ _ π π' _ _ _ _ _ F _ _ _ _ _ _ v ϖ hϖ _ I Q hQ
