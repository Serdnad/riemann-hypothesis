  first | (exact @GlobalTheory.UPel.HT.ES.closure_points_finite_fst) | (exact GlobalTheory.UPel.HT.ES.closure_points_finite_fst) | (intros; apply GlobalTheory.UPel.HT.ES.closure_points_finite_fst <;> assumption)
