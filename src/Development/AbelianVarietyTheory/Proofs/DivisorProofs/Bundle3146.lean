  have hc0 : (0 : ℝ) ≤ c := Nat.cast_nonneg _
  refine ⟨L.image fun ν cl => ((c : ℕ) : ℤ) * ν cl,
    Finset.mem_biUnion.2 ⟨k, Finset.mem_univ _, Finset.mem_image.2 ⟨L, hL, rfl⟩⟩, ?_⟩
  intro b' hb' hb'p hb'min
