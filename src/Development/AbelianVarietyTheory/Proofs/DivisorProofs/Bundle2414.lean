  first | exact @GlobalTheory.TanBaseChange.tan_comb_baseChange | exact GlobalTheory.TanBaseChange.tan_comb_baseChange | (intros; apply GlobalTheory.TanBaseChange.tan_comb_baseChange <;> assumption)
