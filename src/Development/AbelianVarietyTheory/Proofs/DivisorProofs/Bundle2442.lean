  have hU := hL.unf _ hj _ hg
  obtain ⟨hr, hm⟩ := hL.modelW _ hj _ hg
  refine ⟨?_, ((hU.2.1 k).1.trans (hU.2.1 k').1.symm), ((hm k).1.trans (hm k').1.symm),
    ((hm k).2.trans (hm k').2.symm)⟩
  ext τ
  exact ((hU.2.1 k).2 τ).trans ((hU.2.1 k').2 τ).symm

