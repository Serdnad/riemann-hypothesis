theorem surjective_of_factor {X Y Z : Scheme.{0}} (p : X ⟶ Y) (O : X.Opens) (g : Z ⟶ X) (q : Z ⟶ Y)
    (hg : g ≫ p = q) (hq : Surjective q) (hO : ∀ z, g z ∈ O) : Surjective (O.ι ≫ p) := by
  refine ⟨fun y => ?_⟩
  obtain ⟨z, rfl⟩ := hq.surj y
  refine ⟨⟨g z, hO z⟩, ?_⟩
  rw [← hg]
  rfl

