  have e : ∀ {E : Type} [Category.{0} E] {E' : Type} [Category.{0} E'] (F : E ⥤ CommAlgCat.{0} R₀) (G : E' ⥤ E)
      (T : E') (x : R₁ ⊗[R₀] F.obj (G.obj T)), (extMap R₁ (CoefMap.restrict F G)).α T x = x := by
