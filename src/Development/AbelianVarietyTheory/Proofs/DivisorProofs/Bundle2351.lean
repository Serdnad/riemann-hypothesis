    obtain ⟨h1, h2⟩ := GlobalTheory.AdTh.Dic.letter Dc (fun τ => RingHom.ext fun _ => rfl) hm ℓ
    obtain ⟨g1, g2, g3⟩ := hv (Dc.eL ℓ)
