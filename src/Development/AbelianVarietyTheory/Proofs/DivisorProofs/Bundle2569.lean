  have e := congrFun (hev (Submodule.inclusion (cutR_le T.J.toCore.C ((i : ℕ) + 1) (κ i)) F₀)) g
  refine Eq.trans ?_ (e.trans (congrFun (GlobalTheory.LiftRatObj.phiC_congr T.J hso.symm hb.2.2 (O i).hV _ _) g))
