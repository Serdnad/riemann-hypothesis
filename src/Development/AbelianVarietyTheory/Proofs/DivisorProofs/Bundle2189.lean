def diagL : ((κ → F) × (κ → F)) →ₗ[F] ((κ ⊕ κ → F) × (κ ⊕ κ → F)) where
  toFun p := (Sum.elim p.1 p.1, Sum.elim p.2 (-p.2))
  map_add' p q := by
    refine Prod.ext ?_ ?_ <;> funext i <;> cases i <;> simp [add_comm]
  map_smul' c p := by
    refine Prod.ext ?_ ?_ <;> funext i <;> cases i <;> simp

