    (fun y => by
      rw [← map_nsmul, ← hc, hx₃, Over.comp_left, Category.assoc]) N ε hε
  exact ⟨D', L, θ₀, N, ε, e, s, by omega, by omega, hθ, hb, hε, h₁, h₂, h₃⟩

