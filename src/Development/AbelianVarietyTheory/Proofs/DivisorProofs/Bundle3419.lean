  first | (exact @GlobalTheory.KerKilledNear.kerKilledOn_near) | (exact GlobalTheory.KerKilledNear.kerKilledOn_near) | (intros; apply GlobalTheory.KerKilledNear.kerKilledOn_near  <;> assumption)
