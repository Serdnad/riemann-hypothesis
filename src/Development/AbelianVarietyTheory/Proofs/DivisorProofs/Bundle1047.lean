theorem evc_comp_of_iso {S : Scheme.{0}} {A B' B Y : Over S} (j : B' ⟶ B) {P : LB (A ⊗ B).left} (hP : P.IsLB)
    {Q : LB (A ⊗ B').left} (hQ : Q.IsLB) (h : LBIso (P.pull (A ◁ j).left) Q) (a : Y ⟶ A) (u : Y ⟶ B') :
    evc hP a (u ≫ j) = evc hQ a u := by
