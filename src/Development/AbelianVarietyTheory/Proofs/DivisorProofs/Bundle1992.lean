theorem skewGram_inr_inl {D : D7} (A B : HSp D) {d : ℕ} (e : Fin A.rank ⊕ Fin B.rank ≃ Fin d) (a b) :
    _root_.GlobalTheory.IndefiniteRowSideFullHecke.UnitaryConjugation.skewGram A B e (e (.inr a)) (e (.inl b)) = 0 := by
