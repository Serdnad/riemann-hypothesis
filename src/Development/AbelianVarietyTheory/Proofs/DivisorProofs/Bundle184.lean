  first | exact @GlobalTheory.CosetAvg.sum_translates_eq_avg | exact GlobalTheory.CosetAvg.sum_translates_eq_avg | (intros; apply GlobalTheory.CosetAvg.sum_translates_eq_avg <;> assumption)
