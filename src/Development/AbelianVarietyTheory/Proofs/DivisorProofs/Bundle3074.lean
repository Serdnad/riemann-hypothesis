  obtain ⟨levF, hlevF⟩ := GlobalTheory.T.exists_level_structure_geometric_fibre_pullback T F tR P A₀ ψ₀ hA₀ hLA₀ A.g ((n ^ J) ^ 2) hgP ζT ζ hF0 htζ hζ y₀ hyt hpair
  have cover : ∀ z : Over.mk (spMap t.toRingHom) ⟶ P.A, z ^ (n ^ J) = 1 →
