  have hKv := (regular_semisimple_adelic hcm hJ (frameLat V) γ hreg).1
  have hpa : ∀ w, IsProperOrbit (cent (projArch D.sp.cm.sig V.gram w (ratEmb D.sp.cm.sig V.gram γ)))
