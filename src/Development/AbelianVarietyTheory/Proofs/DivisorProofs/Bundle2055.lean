  have hshell : ∀ m : Fin a → ℤ,
      _root_.GlobalTheory.SplitFlip.shellSet ϖ m = _root_.GlobalTheory.GLDoubling.cell k (Fin a) ϖ m := by
    intro m
    unfold _root_.GlobalTheory.GLDoubling.cell _root_.GlobalTheory.SplitFlip.shellSet
