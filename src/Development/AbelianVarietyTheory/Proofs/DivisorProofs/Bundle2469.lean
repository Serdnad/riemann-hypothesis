  obtain ⟨σ, -, hloc, hiff⟩ := GlobalTheory.DefU.exists_locComp_split E n ⟨π, hπ⟩ w hw
  obtain ⟨S, hS⟩ := GlobalTheory.SatInd.exists_hasSatGL_of_isIrreducible σ.smooth σ.irred (hiff.1 ⟨φ, hφ, h0, hfix⟩)
