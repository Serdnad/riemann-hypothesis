  first | exact @GlobalTheory.Desc.exists_spread_basicOpen_agree | exact GlobalTheory.Desc.exists_spread_basicOpen_agree | (intros; apply GlobalTheory.Desc.exists_spread_basicOpen_agree <;> assumption)
