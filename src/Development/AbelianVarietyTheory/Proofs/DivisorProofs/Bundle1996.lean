    refine Submodule.span_le.2 ?_
    rintro _ ⟨u, hu, Ψ, hΨ, rfl⟩
    show p' (ωB (u, 1) Ψ - Ψ) = 0
    rw [map_sub, hM.mapB.invf u hu Ψ hΨ, sub_self]
