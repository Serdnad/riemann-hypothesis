theorem pow_five_add_one_lt {y : ℝ} (hy : 16 ≤ y) : y ^ (5 : ℕ) + 1 < y ^ (6 : ℕ) := by
  have h1 : (1 : ℝ) ≤ y ^ (5 : ℕ) := one_le_pow₀ (by linarith)
  have h2 := mul_le_mul_of_nonneg_right hy (zero_le_one.trans h1)
  have e : y ^ (6 : ℕ) = y * y ^ (5 : ℕ) := by ring
  rw [e]
  linarith

