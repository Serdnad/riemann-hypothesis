  first | exact @GlobalTheory.HeckeLift.exists_linearMap_of_isHkIsog | exact GlobalTheory.HeckeLift.exists_linearMap_of_isHkIsog | (intros; apply GlobalTheory.HeckeLift.exists_linearMap_of_isHkIsog <;> assumption)
