abbrev Ten {F E : Type} [Field F] [Field E] [Algebra F E] {σ : E →ₐ[F] E} {r : ℕ} (P : PPol σ r) (k : Type) [CommRing k]
    [Algebra F k] : Type := k ⊗[F] Fld P

local instance (priority := high) normSubgroupNormal {E : Type} [Field E] [NumberField E] [IsCMField E]
    {r : ℕ} (P : GlobalTheory.IndefiniteRowSideFullHecke.SelfReciprocalLocalField.SelfRecip E r)
    (k : Type) [CommRing k] [Algebra (maximalRealSubfield E) k] :
    (GlobalTheory.IndefiniteRowSideFullHecke.SelfReciprocalLocalField.norms P k).Normal where
  conj_mem n hn g := by
    have h : g * n = n * g := Units.ext (mul_comm _ _)
    rwa [h, mul_assoc, mul_inv_cancel, mul_one]

local instance (priority := high) normClassMulOne {E : Type} [Field E] [NumberField E] [IsCMField E]
    {r : ℕ} (P : GlobalTheory.IndefiniteRowSideFullHecke.SelfReciprocalLocalField.SelfRecip E r)
    (k : Type) [CommRing k] [Algebra (maximalRealSubfield E) k] :
    MulOne (GlobalTheory.IndefiniteRowSideFullHecke.SelfReciprocalLocalField.NormClass P k) :=
  (QuotientGroup.Quotient.commGroup (GlobalTheory.IndefiniteRowSideFullHecke.SelfReciprocalLocalField.norms P k)).toMulOne

