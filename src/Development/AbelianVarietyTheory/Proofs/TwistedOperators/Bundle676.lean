  have hreal := GlobalTheory.T.jointHarmonics_lowest_KType_coefficient_real hHM R F hPM i t σ s P cμ cη m ω BW f₀ f c io h μ 𝓧 hμ g hg e e' w w'
  obtain ⟨hC, -, -, -, -, hW, hON, -, hPt, -, -⟩ := h
