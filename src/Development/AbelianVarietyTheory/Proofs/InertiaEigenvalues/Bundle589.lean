private theorem padicInt_hom_ext (f g : ℤ_[l] →+* _root_.Formalism.Per.Ainf l) (z : ℤ_[l]) : f z = g z := by
  have hH : IsHausdorff (Ideal.span {((l : ℕ) : _root_.Formalism.Per.Ainf l)}) (_root_.Formalism.Per.Ainf l) := inferInstance
  rw [← sub_eq_zero]
  refine hH.haus _ fun n => ?_
  obtain ⟨w, hw⟩ := Ideal.mem_span_singleton'.1 (PadicInt.appr_spec n z)
  have hz : z = w * (l : ℤ_[l]) ^ n + (z.appr n : ℤ_[l]) := by rw [hw]; ring
  rw [SModEq.zero, smul_eq_mul, Ideal.mul_top, Ideal.span_singleton_pow, Ideal.mem_span_singleton']
  refine ⟨f w - g w, ?_⟩
  have hf := congrArg f hz
  have hg := congrArg g hz
  simp only [map_add (f := _), map_mul, map_pow, map_natCast] at hf hg
  rw [hf, hg]
  ring

theorem map_smul_ring {R S : Type} [CommRing R] [CommRing S] {n : Type} (f : R →+* S) (c : R)
    (M : Matrix n n R) : (c • M).map f = f c • M.map f := by
  ext i j
  simp [Matrix.map_apply, Matrix.smul_apply]

theorem exists_lift (C : Core l) (hA : C.AwayT) {d : ℕ} (U : Matrix (Fin d) (Fin d) (_root_.Formalism.Per.Bcris l)) :
    ∃ N₀ : ℕ, ∀ N : ℕ, N₀ ≤ N → ∃ Z : Matrix (Fin d) (Fin d) (_root_.Formalism.Per.Acris l),
      Z.map (algebraMap (_root_.Formalism.Per.Acris l) (_root_.Formalism.Per.Bcris l)) = algebraMap (_root_.Formalism.Per.Acris l) (_root_.Formalism.Per.Bcris l) C.t ^ N • U := by
  haveI : IsLocalization.Away C.t (_root_.Formalism.Per.Bcris l) := hA
  have h : ∀ i j, ∃ k : ℕ, ∃ a : _root_.Formalism.Per.Acris l,
      U i j * algebraMap (_root_.Formalism.Per.Acris l) (_root_.Formalism.Per.Bcris l) C.t ^ k = algebraMap (_root_.Formalism.Per.Acris l) (_root_.Formalism.Per.Bcris l) a := by
    intro i j
    obtain ⟨⟨a, s⟩, hs⟩ := IsLocalization.surj (Submonoid.powers C.t) (U i j)
    obtain ⟨k, hk⟩ := s.2
    refine ⟨k, a, ?_⟩
    have hk' : C.t ^ k = (s : _root_.Formalism.Per.Acris l) := hk
    rw [← map_pow, hk']
    exact hs
  choose k a ha using h
  refine ⟨Finset.univ.sup fun p : Fin d × Fin d => k p.1 p.2, fun N hN =>
    ⟨Matrix.of fun i j => a i j * C.t ^ (N - k i j), ?_⟩⟩
  ext i j
  have hk : k i j ≤ N :=
    le_trans (Finset.le_sup (f := fun p : Fin d × Fin d => k p.1 p.2) (Finset.mem_univ (i, j))) hN
  simp only [Matrix.map_apply, Matrix.of_apply, Matrix.smul_apply, smul_eq_mul, map_mul, map_pow, ← ha]
  rw [mul_assoc, ← pow_add, Nat.add_sub_cancel' hk, mul_comm]

end GlobalTheory.CrisPeriods

