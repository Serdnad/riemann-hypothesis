    @Module.finrank ↥LL.1 ↥(Di (HW l) h T i) _ (Submodule.addCommMonoid _) (Submodule.module _) =
      Module.finrank ↥LL.1 T.V := by
  intro D HW l _ K s LL h W T hT i ζ τ ι hC hτ
