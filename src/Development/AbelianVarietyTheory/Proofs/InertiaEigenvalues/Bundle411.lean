  first | exact @GlobalTheory.SplitHeckeComm.doubleCoset_comm | exact GlobalTheory.SplitHeckeComm.doubleCoset_comm | (intros; apply GlobalTheory.SplitHeckeComm.doubleCoset_comm <;> assumption)
