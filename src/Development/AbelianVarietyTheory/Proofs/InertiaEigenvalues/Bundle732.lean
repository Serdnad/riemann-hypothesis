theorem kappa_tmul (F : FinIso L n) (x : L) (a : AFplus L) :
    F.κ.toRingHom (x ⊗ₜ[L⁺] a) = algebraMap L _ x * GlobalTheory.AdeleBaseChange.adMap L⁺ L a := by
