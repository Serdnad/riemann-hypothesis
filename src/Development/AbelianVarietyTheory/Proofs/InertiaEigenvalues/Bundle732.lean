theorem entry_mem {w : HeightOneSpectrum (𝓞 L)} {g : GL (Fin n) (w.adicCompletion L)} (hg : g ∈ GlobalTheory.LFun.KGL w (n := n))
    (i j : Fin n) : g.val i j ∈ w.adicCompletionIntegers L := by
