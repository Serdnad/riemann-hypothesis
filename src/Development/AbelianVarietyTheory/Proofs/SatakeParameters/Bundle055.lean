  first | exact @GlobalTheory.Hk3.IntWittBase.witt_mod_base | exact GlobalTheory.Hk3.IntWittBase.witt_mod_base | (intros; apply GlobalTheory.Hk3.IntWittBase.witt_mod_base <;> assumption)
