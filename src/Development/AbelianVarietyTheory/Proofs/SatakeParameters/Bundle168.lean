  first | exact @GlobalTheory.Hk3.MinuscTop.elemDiv_mul_minuscule | exact GlobalTheory.Hk3.MinuscTop.elemDiv_mul_minuscule | (intros; apply GlobalTheory.Hk3.MinuscTop.elemDiv_mul_minuscule <;> assumption)
