    {G : Matrix (Fin r) (Fin r) E} {L : Submodule (NumberField.RingOfIntegers E) (Fin r → E)} :
    _root_.ReciprocityTheory.ChartRestriction.G.FD.IsUStab G L (1 : GL (Fin r) E) := by
