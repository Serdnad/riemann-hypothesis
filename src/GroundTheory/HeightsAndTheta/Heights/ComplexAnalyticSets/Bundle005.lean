def NonIsolatedFibreCurve.Statement : Prop :=
  ∀ (k m : ℕ) (U : Set (Fin k → ℂ)) (f : (Fin k → ℂ) → Fin m → ℂ) (p : Fin k → ℂ),
    IsOpen U → DifferentiableOn ℂ f U → p ∈ U → AccPt p (𝓟 {v | v ∈ U ∧ f v = f p}) →
