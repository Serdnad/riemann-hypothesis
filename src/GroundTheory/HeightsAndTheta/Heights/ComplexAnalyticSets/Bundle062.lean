            Tendsto (fun ε => varInt J (d + 1) f (vecCons (logReg u ε) φ)) (𝓝[>] 0)
              (𝓝 (∑ᶠ (W : Ideal (MvPolynomial (Fin n) ℂ))
                  (_ : W ∈ (J ⊔ Ideal.span {linForm u}).minimalPrimes),
                (localMult (J ⊔ Ideal.span {linForm u}) W : ℝ) * varInt W d f φ))

