    (y : (Σ k, ι k) → Ω) (d : ℕ) (e : K → ℕ) (r : ℕ) (g : Fin r → MRing ι),
    IsArithVar (mCoordIdeal y) d → (∀ i, IsMultiHomog (g i) e) →
    LinearIndependent ℤ (fun i => aeval y (g i)) →
    ∀ c : Fin r → ℝ,
      (∀ z ∈ mcPts (mCoordIdeal y), ∑ i, (c i : ℂ) * eval z (map (Int.castRingHom ℂ) (g i)) = 0) →
      c = 0

end

